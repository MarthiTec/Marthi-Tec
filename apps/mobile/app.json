{
  "expo": {
    "name": "Marthi Lojista",
    "slug": "marthi-lojista",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "marthi-lojista",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101820"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.marthi.lojista",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "O Marthi Lojista usa a câmera para ler código de barras e IMEI no estoque."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101820"
      },
      "package": "app.marthi.lojista",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O Marthi Lojista usa a câmera para ler código de barras e IMEI no estoque."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      },
      "apiUrl": "https://marthi-totem.discloud.dev"
    }
  }
}
