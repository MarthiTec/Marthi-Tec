{
  "name": "marthi-tec",
  "private": true,
  "version": "0.1.0",
  "description": "Marthi - plataforma de autoatendimento (API Node + React + PostgreSQL)",
  "main": "index.js",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p apps/api/tsconfig.json && npm --prefix apps/web run build && node -e \"require('fs').accessSync('dist/public/index.html')\"",
    "start": "node index.js",
    "dev:api": "npm run dev --workspace=@marthi/api",
    "dev:web": "npm run dev --workspace=@marthi/web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "npm --prefix apps/web run build",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "jose": "^6.0.10",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "zod": "^3.24.2"
  },
  "workspaces": [
    "apps/*"
  ]
}
