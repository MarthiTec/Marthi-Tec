# ==============================================================================
# Cole estas variáveis no Painel Discloud do aplicativo: marthi-totem
# Menu: Gerenciar Aplicativo -> Variáveis de Ambiente (Environment Variables)
# NUNCA commitar senhas reais — use o painel Discloud / secrets do ambiente.
# ==============================================================================

APP_ENV=production
PORT=8080
APP_NAME=Marthi Platform
FRONTEND_URL=https://marthi-totem.discloud.app

# PostgreSQL MarthiDB (VLAN Discloud). Substitua USER/PASSWORD/HOST pelos valores do painel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/MarthiDB

JWT_SECRET=
GOOGLE_CLIENT_ID=

EVOLUTION_BASE_URL=https://marthi-tec.discloud.app
EVOLUTION_INSTANCE=marthi
EVOLUTION_API_KEY=
EVOLUTION_STORE_NUMBER=
EVOLUTION_NOTIFY_CUSTOMER=false

# Opcional — só se o usuário já existir no MarthiDB (ou após db:seed-demo)
AUTH_DEV_EMAIL=
AUTH_DEV_PASSWORD=

TOTEM_LOCATION_LABEL=Loja Demonstração

# DeviceSpecs / RapidAPI (ajuda e ficha de Samsung/Xiaomi/Motorola/etc. no cadastro).
# iPhone não precisa desta chave. Obter em https://ds.gtgroup.dev/docs (RapidAPI).
# DEVICE_CATALOG_API_KEY=

