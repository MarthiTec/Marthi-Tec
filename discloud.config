NAME=Marthi Platform
TYPE=site
ID=marthi-totem
MAIN=index.js
RAM=1024
VERSION=latest
VLAN=true
BUILD=npm install --include=dev && npm run build:api && npm run copy:migrations && npm --prefix apps/web run build && test -f dist/public/index.html && node -e "const fs=require('fs');const s=fs.readdirSync('apps/api/src/db/migrations').filter(f=>f.endsWith('.sql')).sort();const d=fs.readdirSync('dist/db/migrations').filter(f=>f.endsWith('.sql')).sort();if(s.join()!=d.join()){console.error('dist migrations != source',{src:s.length,dist:d.length,missing:s.filter(x=>!d.includes(x))});process.exit(1)}console.log('migrations ok',d.length,d.at(-1))"
START=node index.js
AUTORESTART=true

