# Cole estas variáveis no Site Discloud: marthi-backend (Nest) ou API Site.
# Mantenha o DATABASE_URL no painel (Postgres Discloud). Nunca commitar senha real.

NODE_ENV=production
PORT=8080
API_PREFIX=api/v1
SWAGGER_ENABLED=true

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/MarthiDB?schema=public

JWT_SECRET=
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=

AUTH_DEV_EMAIL=
AUTH_DEV_PASSWORD=

CORS_ORIGINS=https://marthi-totem.discloud.app,http://localhost:5173,http://127.0.0.1:5173

# DeviceSpecs / RapidAPI — fallback multi-marca (ajuda/ficha). Sem chave, só iPhone gratis.
# DEVICE_CATALOG_API_KEY=

