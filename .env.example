APP_ENV=development
APP_NAME=Marthi API
PORT=8080

# PostgreSQL (Discloud / local)
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Opcional: connection string completa
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Auth
JWT_SECRET=troque-este-segredo-em-producao
GOOGLE_CLIENT_ID=
# Login local temporário (até termos usuários no banco)
AUTH_DEV_EMAIL=teste@marthi.com.br
AUTH_DEV_PASSWORD=123
# Staff Marthi — Painel interno `/marthi` (ops; não é operador de loja)
AUTH_MARTHI_EMAIL=marthi.tecnologia@gmail.com
AUTH_MARTHI_PASSWORD=Marthi170926

# Frontend (Vite)
# DEV: deixe VITE_API_URL vazio — proxy em apps/web/vite.config.ts evita CORS
# BUILD produção (Site totem):
# VITE_API_URL=https://marthi-backend.discloud.app
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
# Staff Marthi (fallback local quando a API não autentica staff)
VITE_AUTH_MARTHI_EMAIL=marthi.tecnologia@gmail.com
VITE_AUTH_MARTHI_PASSWORD=Marthi170926
# Senha para sair do totem (shopping 24h). Padrão: cellponto
VITE_TOTEM_EXIT_PASSWORD=cellponto

# Evolution API (WhatsApp) — um SERVIDOR, várias INSTÂNCIAS possíveis
# 1 instância = 1 número WhatsApp pareado (QR). A mesma API envia para qualquer destino.
EVOLUTION_BASE_URL=https://marthi-tec.discloud.app
EVOLUTION_INSTANCE=marthi
EVOLUTION_API_KEY=
# Fallback do número da loja (cada loja também configura no Painel → Totem → WhatsApp)
EVOLUTION_STORE_NUMBER=
# true = também avisa o cliente no WhatsApp (a loja pode ligar/desligar no painel)
EVOLUTION_NOTIFY_CUSTOMER=false
# Texto opcional na mensagem (ex: Shopping Olga Sola, Três Rios) — painel sobrescreve
TOTEM_LOCATION_LABEL=
# Número comercial Marthi (trabalhe conosco / suporte / CRM) — mesmo Evolution, outro destino
# EVOLUTION_MARTHI_NUMBER=5524981244253
