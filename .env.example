APP_ENV=development
APP_NAME=Marthi API
PORT=8080

# PostgreSQL — MarthiDB (obrigatório em produção / Discloud)
# Preferir connection string completa:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/MarthiDB

# Alternativa por campos (usado se DATABASE_URL estiver vazio)
DB_HOST=
DB_PORT=5432
DB_DATABASE=MarthiDB
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Frontend (Vite)
# DEV: deixe vazio — o Vite encaminha /api para a API local (http://127.0.0.1:8080)
# Para usar a API publicada sem subir o backend:
# VITE_API_URL=https://marthi-backend.discloud.app
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=

# Evolution API (WhatsApp) — um SERVIDOR, várias INSTÂNCIAS possíveis
EVOLUTION_BASE_URL=https://marthi-tec.discloud.app
EVOLUTION_INSTANCE=marthi
EVOLUTION_API_KEY=
EVOLUTION_STORE_NUMBER=
EVOLUTION_NOTIFY_CUSTOMER=false
TOTEM_LOCATION_LABEL=
# Número comercial Marthi (trabalhe conosco / suporte / CRM) — mesmo Evolution, outro destino
# EVOLUTION_MARTHI_NUMBER=5524981244253

# Login de desenvolvimento (opcional). Só funciona se existir loja ativa no MarthiDB.
# AUTH_DEV_EMAIL=
# AUTH_DEV_PASSWORD=

# DeviceSpecs / RapidAPI — fallback da plataforma para ajuda/ficha multi-marca (≠ iPhone).
# Colar também no Site Discloud (Variáveis). Sem isso, cada loja cadastra a chave em /erp/api-aparelhos.
# DEVICE_CATALOG_API_KEY=
# Máximo de consultas/dia (plano grátis da RapidAPI = 15; acima disso cobra). 0 = sem trava.
# DEVICE_CATALOG_DAILY_LIMIT=15

# Cobrança recorrente SaaS — pagamento do cliente em /painel/lojas; ops em /admin/assinaturas
# BILLING_PROVIDER=manual
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_PORTAL_RETURN_URL=   # default lojista: {FRONTEND_URL}/painel/lojas
# ASAAS_API_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
