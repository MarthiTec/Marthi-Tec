APP_ENV=development
APP_NAME=Marthi API
PORT=8080

# PostgreSQL (Discloud / local)
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Opcional: connection string completa
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Auth
JWT_SECRET=troque-este-segredo-em-producao
GOOGLE_CLIENT_ID=
# Login local temporário (até termos usuários no banco)
AUTH_DEV_EMAIL=teste@marthi.com.br
AUTH_DEV_PASSWORD=123

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
# Senha para sair do totem (shopping 24h). Padrão: cellponto
VITE_TOTEM_EXIT_PASSWORD=cellponto

# Evolution API (WhatsApp) — substitui WhatsGW
EVOLUTION_BASE_URL=https://marthi-tec.discloud.app
EVOLUTION_INSTANCE=marthi
EVOLUTION_API_KEY=
# Número da loja que recebe o lead (com DDI, ex: 5524999999999)
EVOLUTION_STORE_NUMBER=
# true = também avisa o cliente no WhatsApp
EVOLUTION_NOTIFY_CUSTOMER=false
# Texto opcional na mensagem (ex: Shopping Olga Sola, Três Rios)
TOTEM_LOCATION_LABEL=
